# ============================================================================
# DEZAFIRA — Variáveis do serviço libsql-server no Railway
# Cole estas no Railway (Service → Variables) ou use scripts/setup_railway.sh
# ============================================================================

# --- Rede / porta -----------------------------------------------------------
# O Dockerfile já fixa 0.0.0.0:8080 (Railway roteia para o EXPOSE). Não mexa.
SQLD_HTTP_LISTEN_ADDR=0.0.0.0:8080
# SQLD_GRPC_LISTEN_ADDR=0.0.0.0:5001   # desnecessário p/ o @libsql/client (HTTP)

# --- Modo do nó -------------------------------------------------------------
SQLD_NODE=primary

# --- Autenticação (OBRIGATÓRIO) ---------------------------------------------
# Segredo usado para assinar os JWTs de acesso. Gere com:  openssl rand -hex 32
# O token em si é gerado por libsql-server/generate-token.mjs (ou rotate-token.mjs)
SQLD_AUTH_JWT_KEY=coloque_um_segredo_forte_aqui

# --- Backup automático (bottomless → Railway Bucket, OPCIONAL) ---------------
# O sqld v0.24.32 já vem com bottomless compilado — basta ativar por env.
# Passos:  railway bucket create dezafira-libsql-backups --region sjc --json
#          railway bucket credentials --bucket dezafira-libsql-backups --json
# (1) ativar a replicação
# SQLD_ENABLE_BOTTOMLESS_REPLICATION=true
# (2) bucket (nome = valor do `--bucket`)
# LIBSQL_BOTTOMLESS_BUCKET=dezafira-libsql-backups
# (3) endpoint S3 do Railway (saída do `bucket credentials`, campo endpoint/URL)
# LIBSQL_BOTTOMLESS_ENDPOINT=https://<endpoint-do-bucket>
# (4) credenciais S3 (campos access_key_id / secret_access_key do comando acima)
# LIBSQL_BOTTOMLESS_AWS_ACCESS_KEY_ID=coloque_access_key
# LIBSQL_BOTTOMLESS_AWS_SECRET_ACCESS_KEY=coloque_secret_key
# (5) região do bucket (sjc/iad/ams/sin)
# LIBSQL_BOTTOMLESS_AWS_DEFAULT_REGION=sjc
# (6) NAMESPACE fixo — necessário para o RESTORE encontrar o backup certo.
#     Defina UMA VEZ e nunca mude depois de começar a replicar.
#     (Deve começar com "ns-".) Se não definir, o sqld usa "ns-default".
# LIBSQL_BOTTOMLESS_DATABASE_ID=ns-dezafiraclube
#
# Extras opcionais:
# LIBSQL_BOTTOMLESS_COMPRESSION=zstd       # compacta o backup
# LIBSQL_BOTTOMLESS_ENCRYPTION_KEY=...     # criptografa o backup (32 bytes base64)
# LIBSQL_BOTTOMLESS_BATCH_INTERVAL_SECS=1  # intervalo entre uploads de WAL
