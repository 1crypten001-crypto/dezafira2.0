# ============================================
# Database - Turso (LibSQL)
# ============================================
# Local development: DATABASE_URL=file:local.db
# Production: DATABASE_URL=libsql://your-db.turso.io
# Get credentials at: https://turso.tech
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=your_auth_token_here

# ============================================
# Configurações do Blog
# ============================================
# LOCAL: Use SQLite (better-sqlite3) - para desenvolvimento
DATABASE_PATH=./blog.db

# Credenciais do Admin (USE SENHAS FORTES EM PRODUÇÃO!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MinhaSenhaForte123!@#

# API Key do Gemini (necessária para importação do YouTube)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_API_MODEL=gemini-2.5-flash

# URL do site (para sitemaps/RSS)
SITE_URL=https://seusite.com

# ============================================
# ADM (Dezafira Adm - Blueprint/VSL/analytics)
# ============================================
# Usada pelo VslPlayer do Clube para enviar analytics de retenção da VSL
# (headline A/B/C, % assistido, sessão). Se vazio, usa a produção.
PUBLIC_ADM_API_URL=https://dezafiraadm-production.up.railway.app

# ORIGIN (Obrigatório em produção para evitar erro 403 "Cross-site POST form submissions forbidden")
# Deve bater exatamente com a URL de acesso do site (incluindo protocolo e porta se houver)
# Exemplo: ORIGIN=https://danisaints.com ou ORIGIN=http://92.246.131.72
# ORIGIN=

# NODE_ENV (Deixe comentado. O Vite configura automaticamente como 'production' no build.
# Se for rodar via PM2, passe como variável de ambiente no comando ou ecosystem.config)
# NODE_ENV=production

# ============================================
# Cloudinary (Image Uploads)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# SvelteKit Server Configuration
# ============================================
# Limit request body size (e.g., 104857600 bytes = 100MB) for image and product uploads
BODY_SIZE_LIMIT=104857600

# ============================================
# Persistent Uploads (Optional for git-based deploys)
# ============================================
# If defined, product files will be uploaded and served from this absolute path.
# This prevents uploaded files from being wiped during Git deployments (e.g., on Hostinger).
# Example: PRODUCT_UPLOADS_DIR=/home/u123456789/domains/danisaints.com/uploads
# PRODUCT_UPLOADS_DIR=