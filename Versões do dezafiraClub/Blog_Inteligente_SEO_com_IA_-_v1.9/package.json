{
  "name": "blog-svelte-sqlite",
  "version": "1.9.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build && node scripts/postbuild.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "migrate": "ts-node migrations/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "analyze": "ANALYZE=true vite build --config vite.config.analyze.ts",
    "deploy:vercel": "vercel --prod",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "health": "tsx scripts/health-check.ts",
    "build:analyze": "npm run analyze",
    "lint": "eslint src --ext .ts,.svelte",
    "init-db": "tsx scripts/init-db.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@vitest/ui": "^2.1.8",
    "dotenv": "^17.4.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "svelte-migrate": "^1.10.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@microsoft/clarity": "^1.0.2",
    "@sveltejs/adapter-node": "^5.5.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.6.0",
    "cloudinary": "^2.10.0",
    "dompurify": "^3.3.3",
    "ioredis": "^5.3.2",
    "isomorphic-dompurify": "^2.9.0",
    "jsdom": "^29.0.2",
    "pg": "^8.11.3",
    "stripe": "^22.3.1",
    "zod": "^3.22.4"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "type": "module"
}
