# ════════════════════════════════════════════════════════════════════
# DEZAFIRA — Variáveis de Ambiente
# ════════════════════════════════════════════════════════════════════

# ─── LLM Cascade (pelo menos 1 obrigatório) ───────────────────────
# O sistema tenta cada provedor em ordem até um funcionar:
# NVIDIA NIM → OpenRouter → Gemini → DeepSeek
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Imagens (recomendado pelo menos um) ──────────────────────────
# Agnes AI (agnes-image-2.1-flash) — IA OFICIAL de imagens da Dezafira.
# OpenAI-compatible: POST https://apihub.agnes-ai.com/v1/images/generations
# É o primeiro provedor da cascata (apihub.agnes-ai.com, token no console Agnes).
AGNES_API_KEY=
# FLUX.1 via Hugging Face Inference API (geração AI)
HUGGINGFACE_TOKEN=
# Pexels API (fotos stock de alta qualidade)
PEXELS_API_KEY=

# ─── Banco de Dados ──────────────────────────────────────────────
# SQLite (dev): sqlite:///./dezafira.db
# PostgreSQL (Railway): postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./dezafira.db

# ─── Site (produção) ─────────────────────────────────────────────
SITE_URL=https://dezafira.com.br

# ─── Telegram (opcional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Obscura (opcional - desabilitado por padrão) ────────────────
OBSCURA_ENABLED=false

# ─── Blueprint → Clube (publicação) ──────────────────────────────
# URL pública do Clube usada pela ponte (import-product/sync-blog/member-course)
CLUBE_PUBLIC_URL=https://www.dezafira.com.br
# Chave compartilhada com o Clube (== IMPORT_API_KEY de lá)
CLUBE_IMPORT_KEY=
# URL pública do backend Adm (links de entrega dos produtos: /curso/{id}, /miniapps/...)
BACKEND_URL=http://localhost:8000
# Token da CLI do Clube (Admin → CLI & API) — usado para publicar a landing do Blueprint
CLI_TOKEN=

# ─── Segredos ────────────────────────────────────────────────────
SECRET_KEY=

# ─── Hermes Agent + AionUi WebUI (chat do admin) ────────────────
# URL pública do AionUi WebUI (Cowork). Quando definida, GET /chat do
# backend redireciona o admin para o AionUi (ex: https://aionui-webui-production.up.railway.app)
HERMES_WEBUI_PUBLIC_URL=
# URL do gateway OpenAI-compatível do Hermes Agent (Nous). O backend usa
# engine hermes_official e cai na cascata LLM se indisponível.
# Produção (rede interna Railway): http://hermes-agent.railway.internal:8642/v1
HERMES_GATEWAY_URL=
# Chave de serviço que dá ao Hermes (no AionUi) acesso admin à API sem JWT
# via header X-Service-Key. Comparada em tempo constante (hmac.compare_digest).
SERVICE_API_KEY=
# Mesma chave, mas dentro do container do hermes-agent (o agente lê com
# `echo $DEZAFIRA_SERVICE_KEY` e usa nos curls — nunca expõe em texto).
DEZAFIRA_SERVICE_KEY=

# ─── Pagamentos (Asaas) ────────────────────────────────────────────
# Token da API Asaas (formato $aact_prod_... = produção, $aact_sandbox_... = sandbox).
# Usado no checkout PIX da venda (1Convite e produtos da fábrica): módulo
# modules/asaas_client.py + endpoints /api/v1/asaas/*.
ASAAS_API_KEY=

# ─── Descoberta (Agente Dario) ─────────────────────────────────────
# Google Programmable Search Engine (CSE) do dono — usado pelo Dario SEO
# (modules/google_seo_spy.py) para keywords de artigos de blog/backlinks.
# A cx vem do painel: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=
# Chave da Google Custom Search JSON API — opcional. Sem ela, o Dario SEO
# usa o motor CSE (cx) via Chrome/Obscura (scraping da página do CSE).
GOOGLE_API_KEY=

# ─── Conselheiros IA do 1Convite (sidecar LWC) ────────────────────
# URL do sidecar Node (web/1convite/backend-lwc) — o FastAPI faz proxy de
# /api/v1/chatgpt/* para cá. Sem valor, os Conselheiros respondem 503 offline.
LWC_SIDECAR_URL=
