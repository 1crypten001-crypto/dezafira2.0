# ════════════════════════════════════════════════════════════════════
# DEZAFIRA — Variáveis de Ambiente
# ════════════════════════════════════════════════════════════════════

# ─── LLM Cascade (pelo menos 1 obrigatório) ───────────────────────
# O sistema tenta cada provedor em ordem até um funcionar:
# NVIDIA NIM → OpenRouter → Gemini → DeepSeek
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Imagens (recomendado pelo menos um) ──────────────────────────
# FLUX.1 via Hugging Face Inference API (geração AI)
HUGGINGFACE_TOKEN=
# Pexels API (fotos stock de alta qualidade)
PEXELS_API_KEY=

# ─── Banco de Dados ──────────────────────────────────────────────
# SQLite (dev): sqlite:///./dezafira.db
# PostgreSQL (Railway): postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./dezafira.db

# ─── Site (produção) ─────────────────────────────────────────────
SITE_URL=https://dezafira.com.br

# ─── Telegram (opcional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Obscura (opcional - desabilitado por padrão) ────────────────
OBSCURA_ENABLED=false

# ─── Segredos ────────────────────────────────────────────────────
SECRET_KEY=
